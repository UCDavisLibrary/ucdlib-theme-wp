<div class="social-follow">
  {% if attributes.facebookUrl %}
    <a href="{{attributes.facebookUrl}}" alt="Facebook icon link" class="social-follow__facebook" aria-label="Facebook link"></a>
  {% endif %}

  {% if attributes.twitterUrl %}
    <a href="{{attributes.twitterUrl}}" alt="Blue Sky icon link" class="social-follow__twitter" aria-label="Blue Sky link"></a>
  {% endif %}

  {% if attributes.instagramUrl %}
    <a href="{{attributes.instagramUrl}}" alt="Instagram icon link" class="social-follow__instagram" aria-label="Instagram link"></a>
  {% endif %}

  {% if attributes.youtubeUrl %}
    <a href="{{attributes.youtubeUrl}}" alt="YouTube icon link" class="social-follow__youtube" aria-label="YouTube link"></a>
  {% endif %}

  {% if attributes.linkedinUrl %}
    <a href="{{attributes.linkedinUrl}}" alt="LinkedIn icon link" class="social-follow__linkedin" aria-label="LinkedIn link"></a>
  {% endif %}
</div>
